{
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=authdb;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Key": "SUPER-SECRET-JWT-KEY-FOR-DEV-CHANGE-ME",
    "Issuer": "AuthBackend",
    "Audience": "AuthBackendClients"
  },
  "GoogleOAuth": {
    "ClientId": "replace-with-google-client-id.apps.googleusercontent.com",
    "RedirectUri": "http://localhost:8080/auth/google/callback"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
