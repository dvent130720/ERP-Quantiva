{
  "ReverseProxy": {
    "Routes": {
      "billing": {
        "ClusterId": "billing-cluster",
        "Match": { "Path": "/facturas/{**catch-all}" }
      },
      "identity": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" }
      },
      "tenant": {
        "ClusterId": "tenant-cluster",
        "Match": { "Path": "/tenants/{**catch-all}" }
      }
    },
    "Clusters": {
      "billing-cluster": { "Destinations": { "d1": { "Address": "http://billing-service:8080/" } } },
      "identity-cluster": { "Destinations": { "d1": { "Address": "http://identity-service:8080/" } } },
      "tenant-cluster": { "Destinations": { "d1": { "Address": "http://tenant-service:8080/" } } }
    }
  }
}
