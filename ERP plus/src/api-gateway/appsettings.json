{
  "Jwt": {
    "Issuer": "venturacom",
    "Audience": "venturacom-clients",
    "Key": "SuperSecretKey_ChangeMe_AtLeast32Chars"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "SeqUrl": "http://seq:5341"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "tenant": { "ClusterId": "tenant", "Match": { "Path": "/api/tenants/{**catch-all}" } },
      "users": { "ClusterId": "users", "Match": { "Path": "/api/users/{**catch-all}" } },
      "clients": { "ClusterId": "clients", "Match": { "Path": "/api/clients/{**catch-all}" } },
      "invoices": { "ClusterId": "invoices", "Match": { "Path": "/api/invoices/{**catch-all}" } },
      "inventory": { "ClusterId": "inventory", "Match": { "Path": "/api/inventory/{**catch-all}" } },
      "accounting": { "ClusterId": "accounting", "Match": { "Path": "/api/accounting/{**catch-all}" } },
      "dashboard": { "ClusterId": "dashboard", "Match": { "Path": "/api/dashboard/{**catch-all}" } },
      "notifications": { "ClusterId": "notifications", "Match": { "Path": "/api/notifications/{**catch-all}" } },
      "ai": { "ClusterId": "ai", "Match": { "Path": "/api/ai/{**catch-all}" } },
      "sri": { "ClusterId": "sri", "Match": { "Path": "/api/sri/{**catch-all}" } }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://auth-service:8080/" } } },
      "tenant": { "Destinations": { "d1": { "Address": "http://tenant-service:8080/" } } },
      "users": { "Destinations": { "d1": { "Address": "http://user-service:8080/" } } },
      "clients": { "Destinations": { "d1": { "Address": "http://client-service:8080/" } } },
      "invoices": { "Destinations": { "d1": { "Address": "http://invoice-service:8080/" } } },
      "inventory": { "Destinations": { "d1": { "Address": "http://inventory-service:8080/" } } },
      "accounting": { "Destinations": { "d1": { "Address": "http://accounting-service:8080/" } } },
      "dashboard": { "Destinations": { "d1": { "Address": "http://dashboard-service:8080/" } } },
      "notifications": { "Destinations": { "d1": { "Address": "http://notification-service:8080/" } } },
      "ai": { "Destinations": { "d1": { "Address": "http://ai-service:8080/" } } },
      "sri": { "Destinations": { "d1": { "Address": "http://sri-integration-service:8080/" } } }
    }
  }
}
