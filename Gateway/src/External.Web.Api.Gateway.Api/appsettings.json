{
  "Authentication": {
    "Jwt": {
      "Authority": "https://identity.quantiva.local",
      "Audience": "quantiva-gateway",
      "RequireHttpsMetadata": false
    }
  },
  "Observability": {
    "Loki": {
      "Url": ""
    }
  },
  "RateLimiting": {
    "Enabled": false,
    "PermitLimit": 100,
    "QueueLimit": 0,
    "WindowSeconds": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp.ReverseProxy": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Yarp": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated",
        "Transforms": [
          {
            "PathPattern": "/api/v1/auth/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
